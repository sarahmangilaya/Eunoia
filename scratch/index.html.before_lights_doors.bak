<!DOCTYPE html>
<html lang="en">
<!--
  ============================================================================
   EUNOIA — A First-Person 3D Museum Portfolio
   Single-File Application (index.html only) · GitHub Pages ready · No build step

   FILE MAP
     §1  <head>  : meta, Google Fonts, complete <style> block, ES-module import map
     §2  <body>  : WebGL mount, HUD, crosshair, Lobby, Curator Plaque, Exhibition Index
     §3  EUNOIA_CONFIG : all client-editable content (top of the module script)
     §4  Engine  : textures (with procedural canvas fallbacks), architecture, lighting,
                   first-person controller + collision, raycast inspection, Web Audio
  ============================================================================
-->
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Eunoia — A Museum of Animation &amp; Visual Art</title>
  <meta name="description" content="Eunoia is an interactive first-person 3D museum portfolio. Walk the Grand Rotunda and three gallery wings, inspect each work, or browse the 2D catalog.">
  <meta name="theme-color" content="#001514">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14.5' stroke='%23e6af2e' stroke-width='1.5' fill='%23001514'/%3E%3Cpath d='M22 10.5C20.5 8.8 18.4 8 16 8C11.58 8 8 11.58 8 16C8 20.42 11.58 24 16 24C18.6 24 20.8 23 22.2 21' stroke='%23fbfffe' stroke-width='1.8' stroke-linecap='round' fill='none'/%3E%3Cpath d='M11 16H20.5' stroke='%23fbfffe' stroke-width='1.5' stroke-linecap='round'/%3E%3Ccircle cx='21' cy='16' r='1.8' fill='%23e6af2e'/%3E%3C/svg%3E">

  <!-- Google Fonts: Cormorant Garamond (classical display) + Plus Jakarta Sans (UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- ======================================================================
       §1  STYLES
       ====================================================================== -->
  <style>
    :root {
      /* --- The Client Palette --- */
      --rich-black: #001514;
      --white: #fbfffe;
      --blood-red: #6b0504;
      --brown: #a3320b;
      --xanthous: #e6af2e;

      /* Interface System Mappings */
      --ink: #001514;
      --ink-2: #051f1e;
      --ink-soft: #0a2d2b;
      --ivory: #fbfffe;
      --ivory-dim: #dbe4e2;
      --muted: #8b9c9a;
      --gold: #e6af2e;
      --gold-bright: #ffc94d;
      --gold-deep: #b38217;
      --crimson: #6b0504;
      --terracotta: #a3320b;

      --glass: rgba(0, 21, 20, 0.68);
      --glass-strong: rgba(0, 21, 20, 0.90);
      --glass-line: rgba(230, 175, 46, 0.28);
      --glass-hi: rgba(251, 255, 254, 0.12);
      --radius: 18px;
      --serif: 'Cormorant Garamond', 'Times New Roman', serif;
      --sans: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --ease: cubic-bezier(.22, .8, .2, 1);
    }

    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0; height: 100%; overflow: hidden;
      background: var(--ink); color: var(--ivory);
      font-family: var(--sans); -webkit-font-smoothing: antialiased;
    }
    button { font-family: inherit; cursor: pointer; }
    a { color: inherit; }
    .hidden { display: none !important; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* ---------- WebGL mount ---------- */
    #stage { position: fixed; inset: 0; }
    #stage canvas { display: block; width: 100%; height: 100%; outline: none; }

    /* Cinematic vignette + inspection dim */
    #vignette {
      position: fixed; inset: 0; pointer-events: none; z-index: 2;
      background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 21, 20, 0.65) 100%);
      transition: background .6s var(--ease);
    }
    body.is-inspecting #vignette {
      background: radial-gradient(ellipse at 35% 50%, transparent 30%, rgba(0, 21, 20, 0.82) 100%);
    }
    #fade { position: fixed; inset: 0; background: #001514; opacity: 0; pointer-events: none; z-index: 60; transition: opacity .35s ease; }
    #fade.on { opacity: 1; }

    /* ---------- Liquid glass primitive ---------- */
    .glass {
      background:
        linear-gradient(160deg, var(--glass-hi), transparent 38%),
        var(--glass);
      border: 1px solid var(--glass-line);
      box-shadow:
        inset 0 1px 0 rgba(251, 255, 254, 0.12), inset 0 -1px 0 rgba(0, 21, 20, 0.5), 0 30px 80px -20px rgba(0, 0, 0, 0.8);
      -webkit-backdrop-filter: blur(22px) saturate(140%);
      backdrop-filter: blur(22px) saturate(140%);
    }

    /* ---------- Buttons ---------- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .6em;
      padding: .95em 1.6em; border-radius: 999px; font-size: .86rem; font-weight: 600;
      letter-spacing: .04em; border: 1px solid transparent; text-decoration: none;
      transition: transform .25s var(--ease), background .25s, border-color .25s, color .25s, box-shadow .25s;
      white-space: nowrap;
    }
    .btn:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 3px; }
    .btn-gold {
      color: #001514;
      background: linear-gradient(180deg, var(--gold-bright), var(--gold) 55%, var(--gold-deep));
      box-shadow: 0 10px 30px -10px rgba(230, 175, 46, .65), inset 0 1px 0 rgba(251, 255, 254, .55);
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 16px 40px -12px rgba(230, 175, 46, .85), inset 0 1px 0 rgba(251, 255, 254, .7); }
    .btn-ghost { color: var(--ivory); background: rgba(251, 255, 254, .04); border-color: rgba(251, 255, 254, .22); }
    .btn-ghost:hover { border-color: var(--gold); color: var(--gold-bright); transform: translateY(-2px); }
    .btn-small { padding: .62em 1.1em; font-size: .76rem; }
    .btn kbd, .kbd {
      font-family: var(--sans); font-size: .68rem; font-weight: 600; letter-spacing: .06em;
      padding: .18em .5em; border-radius: 6px; border: 1px solid currentColor; opacity: .7;
    }

    /* ---------- LOBBY ---------- */
    #lobby {
      position: fixed; inset: 0; z-index: 40; display: grid; place-items: center; padding: 24px;
      background:
        radial-gradient(ellipse at 50% 40%, rgba(0, 21, 20, 0.12), rgba(0, 21, 20, 0.85) 75%),
        linear-gradient(180deg, rgba(0, 21, 20, .45), rgba(0, 21, 20, .75));
      transition: opacity .7s var(--ease), visibility .7s;
    }
    #lobby.out { opacity: 0; visibility: hidden; pointer-events: none; }
    .lobby-card {
      width: min(760px, 100%); border-radius: 28px; padding: clamp(28px, 5vw, 56px);
      text-align: center; position: relative; overflow: hidden;
      animation: rise 1.2s var(--ease) both;
    }
    .lobby-card::before {
      content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
      background: radial-gradient(600px 220px at 50% -60px, rgba(230, 175, 46, .20), transparent 70%);
    }
    @keyframes rise { from { opacity: 0; transform: translateY(24px) scale(.985); } to { opacity: 1; transform: none; } }
    .overline {
      font-size: .7rem; letter-spacing: .38em; text-transform: uppercase; color: var(--gold);
      display: flex; align-items: center; justify-content: center; gap: 14px;
    }
    .overline::before, .overline::after { content: ""; width: 36px; height: 1px; background: linear-gradient(90deg, transparent, var(--gold)); }
    .overline::after { transform: scaleX(-1); }
    .wordmark {
      font-family: var(--serif); font-weight: 500; font-size: clamp(3.4rem, 11vw, 7rem);
      letter-spacing: .32em; margin: .18em 0 0; padding-left: .32em; line-height: 1;
      background: linear-gradient(180deg, #fbfffe 15%, var(--gold-bright) 55%, var(--gold-deep) 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
      text-shadow: 0 0 60px rgba(230, 175, 46, .22);
    }
    .tagline { font-family: var(--serif); font-style: italic; font-size: clamp(1.1rem, 2.4vw, 1.45rem); color: var(--ivory-dim); margin: .7em 0 0; }
    .lobby-sub { font-size: .82rem; color: var(--muted); margin: .9em auto 0; max-width: 46ch; line-height: 1.7; }

    .legend { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin: 30px 0 30px; }
    .legend-item {
      padding: 14px 6px 12px; border-radius: 14px; border: 1px solid rgba(251, 255, 254, .09);
      background: rgba(251, 255, 254, .025);
      display: flex; flex-direction: column; align-items: center; gap: 9px;
    }
    .keys { display: flex; gap: 3px; align-items: center; justify-content: center; min-height: 30px; }
    .key {
      min-width: 26px; height: 26px; padding: 0 6px; border-radius: 7px; display: grid; place-items: center;
      font-size: .7rem; font-weight: 700; color: var(--ivory);
      background: linear-gradient(180deg, rgba(251, 255, 254, .14), rgba(251, 255, 254, .04));
      border: 1px solid rgba(251, 255, 254, .2); box-shadow: 0 2px 0 rgba(0, 0, 0, .45);
    }
    .key.wide { min-width: 40px; }
    .legend-label { font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
    .mouse-ico { width: 18px; height: 28px; border: 1.5px solid var(--ivory-dim); border-radius: 10px; position: relative; }
    .mouse-ico::after { content: ""; position: absolute; left: 50%; top: 5px; width: 2px; height: 6px; margin-left: -1px; background: var(--ivory-dim); border-radius: 2px; }
    .mouse-ico.lmb::before { content: ""; position: absolute; left: 0; top: 0; width: 50%; height: 45%; background: var(--gold); border-radius: 9px 0 0 0; opacity: .85; }

    .lobby-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .lobby-foot { margin-top: 30px; padding-top: 20px; border-top: 1px solid rgba(251, 255, 254, .08);
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
      font-size: .74rem; color: var(--muted);
    }
    .lobby-foot .links { display: flex; gap: 16px; flex-wrap: wrap; }
    .lobby-foot a { text-decoration: none; color: var(--ivory-dim); transition: color .2s; }
    .lobby-foot a:hover { color: var(--gold-bright); }
    #loadStatus { display: inline-flex; align-items: center; gap: 8px; }
    #loadStatus .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); animation: pulse 1.4s infinite; }
    #loadStatus.done .dot { animation: none; background: #8fbf7a; }
    @keyframes pulse { 50% { opacity: .25; } }
    .touch-note { margin-top: 16px; font-size: .76rem; color: var(--gold-bright); }

    /* ---------- HUD ---------- */
    #hud { position: fixed; inset: 0; pointer-events: none; z-index: 10; opacity: 0; transition: opacity .5s; }
    body.in-gallery #hud { opacity: 1; }
    .hud-top {
      position: absolute; top: 18px; left: 20px; right: 20px;
      display: flex; justify-content: space-between; align-items: flex-start;
    }
    .hud-brand { display: flex; flex-direction: column; gap: 4px; }
    .hud-brand .name { font-family: var(--serif); font-size: 1.35rem; letter-spacing: .34em; color: var(--ivory); }
    .hud-brand .loc { font-size: .66rem; letter-spacing: .26em; text-transform: uppercase; color: var(--gold); transition: opacity .4s; }
    .hud-actions { display: flex; gap: 10px; pointer-events: auto; }
    .hud-btn {
      height: 42px; padding: 0 16px; border-radius: 999px; color: var(--ivory);
      display: inline-flex; align-items: center; gap: 10px; font-size: .74rem; font-weight: 600; letter-spacing: .08em;
      transition: border-color .2s, color .2s;
    }
    .hud-btn:hover { border-color: var(--gold); color: var(--gold-bright); }
    .hud-btn svg { width: 16px; height: 16px; }
    .hud-btn.icon { width: 42px; padding: 0; justify-content: center; }
    .hud-hint {
      position: absolute; left: 20px; bottom: 18px; font-size: .7rem; letter-spacing: .08em; color: rgba(243, 236, 224, .55);
      display: flex; gap: 14px; flex-wrap: wrap; transition: opacity .4s;
    }
    .hud-hint b { color: var(--ivory); font-weight: 600; }
    .hud-fps { position: absolute; right: 20px; bottom: 18px; font-size: .66rem; letter-spacing: .1em; color: rgba(243, 236, 224, .35); }
    body.is-inspecting .hud-hint, body.is-inspecting #reticleWrap { opacity: 0; }

    /* Room caption (museum wall-text style) */
    #roomCaption {
      position: absolute; left: 50%; top: 16%; transform: translate(-50%, 10px); text-align: center;
      opacity: 0; transition: opacity .9s var(--ease), transform .9s var(--ease);
    }
    #roomCaption.show { opacity: 1; transform: translate(-50%, 0); }
    #roomCaption .num { font-size: .68rem; letter-spacing: .5em; color: var(--gold); text-transform: uppercase; }
    #roomCaption .title { font-family: var(--serif); font-size: clamp(1.8rem, 3.6vw, 2.8rem); font-weight: 500; margin-top: 6px; text-shadow: 0 4px 30px rgba(0, 0, 0, .8); }
    #roomCaption .rule { width: 60px; height: 1px; margin: 12px auto 0; background: linear-gradient(90deg, transparent, var(--gold), transparent); }

    /* ---------- Crosshair & prompt ---------- */
    #reticleWrap { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); transition: opacity .3s; }
    #reticle { position: relative; width: 44px; height: 44px; }
    #reticle .dot {
      position: absolute; left: 50%; top: 50%; width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%;
      background: rgba(243, 236, 224, .9); box-shadow: 0 0 6px rgba(0, 0, 0, .8);
      transition: transform .3s var(--ease), background .3s;
    }
    #reticle .ring {
      position: absolute; inset: 0; border-radius: 50%;
      border: 1.5px solid rgba(230, 195, 126, 0);
      transform: scale(.3); opacity: 0;
      transition: transform .35s var(--ease), opacity .35s, border-color .35s;
    }
    #reticle .ring.outer { border-style: dashed; inset: -6px; }
    #reticle.active .dot { background: var(--gold-bright); transform: scale(1.3); }
    #reticle.active .ring { transform: scale(1); opacity: 1; border-color: rgba(230, 175, 46, .95); box-shadow: 0 0 18px rgba(230, 175, 46, .4); }
    #reticle.active .ring.outer { border-color: rgba(230, 175, 46, .45); box-shadow: none; animation: spin 6s linear infinite; }
    @keyframes spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
    #prompt {
      position: absolute; left: 50%; top: 62px; transform: translate(-50%, 6px); white-space: nowrap;
      padding: 9px 16px; border-radius: 999px; font-size: .76rem; letter-spacing: .04em;
      opacity: 0; transition: opacity .3s, transform .3s var(--ease);
    }
    #prompt.show { opacity: 1; transform: translate(-50%, 0); }
    #prompt .k { color: var(--gold-bright); font-weight: 700; margin-right: 6px; }
    #prompt em { font-family: var(--serif); font-size: 1.05rem; font-style: italic; }

    /* ---------- Resume prompt ---------- */
    #resume {
      position: fixed; inset: 0; z-index: 35; display: grid; place-items: center; cursor: pointer;
      background: radial-gradient(ellipse at center, rgba(0, 21, 20, .2), rgba(0, 21, 20, .75));
    }
    #resume .glass { padding: 18px 28px; border-radius: 999px; font-size: .84rem; letter-spacing: .06em; display: flex; gap: 12px; align-items: center; }
    #resume .glass span:first-child { color: var(--gold-bright); }

    /* ---------- CURATOR PLAQUE (inspection drawer) ---------- */
    #plaque {
      position: fixed; top: 0; right: 0; bottom: 0; z-index: 30; width: min(540px, 100vw);
      display: flex; flex-direction: column; border-radius: 0; border-right: 0; border-top: 0; border-bottom: 0;
      background:
        linear-gradient(160deg, rgba(251, 255, 254, .06), transparent 30%),
        rgba(0, 21, 20, .92);
      transform: translateX(104%); transition: transform .65s var(--ease);
    }
    #plaque.open { transform: none; }
    #plaque::before {
      content: ""; position: absolute; left: 0; top: 8%; bottom: 8%; width: 1px;
      background: linear-gradient(180deg, transparent, var(--gold), transparent);
    }
    .plaque-scroll { flex: 1; overflow-y: auto; padding: 30px 36px 24px; scrollbar-width: thin; scrollbar-color: var(--gold-deep) transparent; }
    .plaque-preview {
      position: relative; border-radius: 6px; overflow: hidden; background: #001514;
      padding: 10px; border: 1px solid rgba(230, 175, 46, .4);
      box-shadow: inset 0 0 0 4px rgba(230, 175, 46, .1), 0 20px 50px -20px #000;
    }
    .plaque-preview img { display: block; width: 100%; max-height: 42vh; object-fit: contain; border-radius: 2px; background: #001514; }
    .plaque-meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 26px; }
    .plaque-no { font-family: var(--serif); font-size: 1.05rem; letter-spacing: .2em; color: var(--gold); }
    .badge {
      font-size: .64rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase;
      padding: .45em 1em; border-radius: 999px; border: 1px solid rgba(230, 175, 46, .5); color: var(--gold-bright);
      background: rgba(230, 175, 46, .12);
    }
    .badge.wing-I { background: #6b0504; color: #fbfffe; border-color: #e6af2e; }
    .badge.wing-II { background: #fbfffe; color: #001514; border-color: #e6af2e; font-weight: 700; }
    .badge.wing-III { background: #001514; color: #e6af2e; border-color: #e6af2e; }
    .badge.wing-IV { background: #e6af2e; color: #001514; border-color: #ffc94d; font-weight: 700; }
    .no.wing-IV { color: #e6af2e; }
    .plaque-title { font-family: var(--serif); font-weight: 500; font-size: clamp(2rem, 4vw, 2.6rem); line-height: 1.05; margin: 14px 0 6px; }
    .plaque-subtitle { font-family: var(--serif); font-style: italic; font-size: 1.2rem; color: var(--ivory-dim); margin: 0; }
    .plaque-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 22px 0; background: rgba(251, 255, 254, .08); border-radius: 12px; overflow: hidden; }
    .plaque-facts div { background: rgba(0, 21, 20, .92); padding: 12px 14px; }
    .plaque-facts dt { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
    .plaque-facts dd { margin: 4px 0 0; font-size: .9rem; color: var(--ivory); }
    .tags { display: flex; flex-wrap: wrap; gap: 7px; }
    .tag { font-size: .7rem; padding: .4em .85em; border-radius: 999px; background: rgba(243, 236, 224, .06); border: 1px solid rgba(243, 236, 224, .1); color: var(--ivory-dim); }
    .divider { display: flex; align-items: center; gap: 12px; margin: 24px 0 14px; color: var(--gold); font-size: .62rem; letter-spacing: .3em; text-transform: uppercase; }
    .divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(230, 175, 46, .6), transparent); }
    .plaque-desc { font-family: var(--serif); font-size: 1.16rem; line-height: 1.65; color: var(--ivory-dim); margin: 0; }
    .plaque-desc::first-letter { font-size: 3.1em; float: left; line-height: .9; padding: 4px 8px 0 0; color: var(--gold-bright); }
    .plaque-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
    .plaque-footer { padding: 18px 36px 24px; border-top: 1px solid rgba(251, 255, 254, .08); display: flex; gap: 10px; flex-wrap: wrap; }
    .plaque-footer .btn { flex: 1; }

    /* ---------- EXHIBITION INDEX (catalog drawer) ---------- */
    #catalog {
      position: fixed; inset: 0; z-index: 32; display: flex; justify-content: flex-end;
      background: rgba(0, 21, 20, .6); opacity: 0; visibility: hidden; transition: opacity .45s, visibility .45s;
    }
    #catalog.open { opacity: 1; visibility: visible; }
    .catalog-panel {
      width: min(980px, 100vw); height: 100%; display: flex; flex-direction: column; border-radius: 0; border-top: 0; border-bottom: 0; border-right: 0;
      background: linear-gradient(160deg, rgba(251, 255, 254, .05), transparent 30%), rgba(0, 21, 20, .94);
      transform: translateX(40px); transition: transform .55s var(--ease);
    }
    #catalog.open .catalog-panel { transform: none; }
    .catalog-head { padding: 28px 34px 18px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid rgba(251, 255, 254, .07); }
    .catalog-head h2 { font-family: var(--serif); font-weight: 500; font-size: 2.3rem; margin: 6px 0 0; }
    .catalog-head .overline { justify-content: flex-start; }
    .catalog-head .overline::before { display: none; }
    .filters { display: flex; gap: 8px; flex-wrap: wrap; padding: 16px 34px 0; }
    .chip {
      font-size: .72rem; font-weight: 600; letter-spacing: .06em; padding: .6em 1.1em; border-radius: 999px;
      color: var(--ivory-dim); background: transparent; border: 1px solid rgba(251, 255, 254, .14); transition: all .2s; transition: all .2s;
    }
    .chip:hover { border-color: var(--gold); color: var(--ivory); }
    .chip.active { background: rgba(230, 175, 46, .18); border-color: var(--gold); color: var(--gold-bright); }
    .catalog-grid {
      flex: 1; overflow-y: auto; padding: 20px 34px 40px;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; align-content: start;
      scrollbar-width: thin; scrollbar-color: var(--gold-deep) transparent;
    }
    .card {
      border-radius: 16px; overflow: hidden; border: 1px solid rgba(251, 255, 254, .08); background: rgba(251, 255, 254, .025);
      display: flex; flex-direction: column; transition: transform .3s var(--ease), border-color .3s;
      animation: rise .6s var(--ease) both;
    }
    .card:hover { transform: translateY(-4px); border-color: rgba(230, 175, 46, .6); box-shadow: 0 12px 30px -10px rgba(230, 175, 46, .35); }
    .card-thumb { position: relative; aspect-ratio: 4 / 3; background: #001514; overflow: hidden; cursor: pointer; }
    .card-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
    .card:hover .card-thumb img { transform: scale(1.05); }
    .card-thumb .no { position: absolute; left: 12px; top: 10px; font-family: var(--serif); font-size: .95rem; letter-spacing: .16em; color: #fff; text-shadow: 0 2px 8px #000; }
    .card-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .card-wing { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; color: var(--gold); }
    .card-title { font-family: var(--serif); font-size: 1.45rem; font-weight: 500; line-height: 1.1; margin: 0; }
    .card-meta { font-size: .76rem; color: var(--muted); }
    .card-actions { display: flex; gap: 8px; margin-top: auto; padding-top: 12px; }
    .card-actions .btn { flex: 1; }

    @media (max-width: 720px) {
      .legend { grid-template-columns: repeat(3, 1fr); }
      .hud-hint, .hud-fps { display: none; }
      .plaque-scroll { padding: 22px 22px 18px; }
      .plaque-footer { padding: 14px 22px 20px; }
      .catalog-head, .filters, .catalog-grid { padding-left: 18px; padding-right: 18px; }
      .hud-btn .label { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>

  <!-- ES-module import map (official three.js build via jsDelivr CDN) -->
  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.169.0/examples/jsm/"
    }
  }
  </script>
</head>

<body>
  <!-- ======================================================================
       §2  BODY · WebGL mount, HUD & overlays
       ====================================================================== -->
  <div id="stage" aria-label="Eunoia 3D museum"></div>
  <div id="vignette"></div>
  <div id="fade"></div>

  <!-- ---------------- HUD ---------------- -->
  <div id="hud">
    <div class="hud-top">
      <div class="hud-brand">
        <span class="name" id="hudTitle">EUNOIA</span>
        <span class="loc" id="hudLoc">Grand Rotunda</span>
      </div>
      <div class="hud-actions">
        <button class="hud-btn glass" id="btnIndex" title="Exhibition Index [TAB]">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          <span class="label">Index</span><span class="kbd">TAB</span>
        </button>
        <button class="hud-btn glass icon" id="btnSound" title="Toggle sound [M]" aria-pressed="true">
          <svg id="icoSoundOn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg>
          <svg id="icoSoundOff" class="hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M17 9l5 6M22 9l-5 6"/></svg>
        </button>
      </div>
    </div>

    <div id="roomCaption"><div class="num" id="capNum">Entrance</div><div class="title" id="capTitle">Grand Rotunda</div><div class="rule"></div></div>

    <div id="reticleWrap">
      <div id="reticle"><span class="ring outer"></span><span class="ring"></span><span class="dot"></span></div>
      <div id="prompt" class="glass"><span class="k">[LMB]</span>Inspect Piece: <em id="promptTitle"></em></div>
    </div>

    <div class="hud-hint" id="hudHint">
      <span><b>WASD</b> Move</span><span><b>Shift</b> Stride</span><span><b>Mouse</b> Look</span>
      <span><b>LMB</b> Inspect</span><span><b>TAB</b> Index</span><span><b>M</b> Sound</span><span><b>ESC</b> Menu</span>
    </div>
    <div class="hud-fps" id="hudFps"></div>
  </div>

  <!-- ---------------- Resume prompt (pointer re-lock needs a click) ---------------- -->
  <div id="resume" class="hidden" role="button" tabindex="0" aria-label="Click to resume walking">
    <div class="glass"><span>●</span><span>Click anywhere to return to the gallery</span><span class="kbd">ESC menu</span></div>
  </div>

  <!-- ---------------- WELCOME LOBBY ---------------- -->
  <div id="lobby">
    <section class="lobby-card glass" aria-labelledby="lobbyTitle">
      <div class="overline" id="lobbyOverline">A Museum of Animation &amp; Visual Art</div>
      <h1 class="wordmark" id="lobbyTitle">EUNOIA</h1>
      <p class="tagline" id="lobbyTagline">Beautiful thinking, made visible.</p>
      <p class="lobby-sub" id="lobbySub">Step into the Grand Rotunda and wander three gallery wings. Approach any work and inspect it to read the curator's notes.</p>

      <div class="legend" aria-label="Controls">
        <div class="legend-item"><div class="keys"><span class="key">W</span><span class="key">A</span><span class="key">S</span><span class="key">D</span></div><span class="legend-label">Move</span></div>
        <div class="legend-item"><div class="keys"><span class="mouse-ico"></span></div><span class="legend-label">Look</span></div>
        <div class="legend-item"><div class="keys"><span class="mouse-ico lmb"></span></div><span class="legend-label">Inspect</span></div>
        <div class="legend-item"><div class="keys"><span class="key wide">TAB</span></div><span class="legend-label">Catalog</span></div>
        <div class="legend-item"><div class="keys"><span class="key wide">ESC</span></div><span class="legend-label">Menu</span></div>
      </div>

      <div class="lobby-actions">
        <button class="btn btn-gold" id="btnEnter">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21V9l9-6 9 6v12"/><path d="M9 21v-7h6v7"/></svg>
          <span id="btnEnterLabel">Enter Exhibition (3D Walk)</span>
        </button>
        <button class="btn btn-ghost" id="btnCatalog">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Browse 2D Catalog
        </button>
      </div>
      <div class="touch-note hidden" id="touchNote">The 3D walk needs a mouse &amp; keyboard. On this device, the 2D catalog offers the full collection.</div>

      <div class="lobby-foot">
        <span id="loadStatus"><span class="dot"></span><span id="loadText">Preparing the galleries…</span></span>
        <span class="links" id="lobbyLinks"></span>
      </div>
    </section>
  </div>

  <!-- ---------------- CURATOR PLAQUE MODAL ---------------- -->
  <aside id="plaque" class="glass" role="dialog" aria-modal="true" aria-labelledby="plqTitle" aria-hidden="true">
    <div class="plaque-scroll">
      <figure class="plaque-preview" style="margin:0">
        <img id="plqImg" alt="">
        <video id="plqVideo" controls loop playsinline class="hidden" style="width:100%;max-height:42vh;background:#001514;display:block"></video>
      </figure>
      <div class="plaque-meta"><span class="plaque-no" id="plqNo">No. 01</span><span class="badge" id="plqWing">Wing I</span></div>
      <h2 class="plaque-title" id="plqTitle"></h2>
      <p class="plaque-subtitle" id="plqSubtitle"></p>
      <dl class="plaque-facts">
        <div><dt>Year</dt><dd id="plqYear"></dd></div>
        <div><dt>Category</dt><dd id="plqCategory"></dd></div>
      </dl>
      <div class="tags" id="plqTags"></div>
      <div class="divider">Curator's Note</div>
      <p class="plaque-desc" id="plqDesc"></p>
      <div class="plaque-links" id="plqLinks"></div>
    </div>
    <div class="plaque-footer">
      <button class="btn btn-ghost hidden" id="plqTeleport">Teleport to Painting</button>
      <button class="btn btn-gold" id="plqClose">Return to Gallery <span class="kbd">ESC</span></button>
    </div>
  </aside>

  <!-- ---------------- QUICK EXHIBITION INDEX ---------------- -->
  <div id="catalog" aria-hidden="true">
    <section class="catalog-panel glass" role="dialog" aria-modal="true" aria-labelledby="catTitle">
      <header class="catalog-head">
        <div>
          <div class="overline" id="catOverline">Exhibition Index</div>
          <h2 id="catTitle">The Collection</h2>
        </div>
        <button class="btn btn-ghost btn-small" id="catClose">Close <span class="kbd">TAB</span></button>
      </header>
      <nav class="filters" id="catFilters" aria-label="Filter by wing"></nav>
      <div class="catalog-grid" id="catGrid"></div>
    </section>
  </div>

  <!-- ======================================================================
       §3 + §4  APPLICATION MODULE
       ====================================================================== -->
  <script type="module">
/* ==========================================================================
   §3  EUNOIA_CONFIG — edit this block to customise the museum.
   --------------------------------------------------------------------------
   • site      : title, tagline, curator details shown in the lobby & HUD.
   • links     : social / contact buttons (lobby footer). Any number allowed.
   • wings     : display names for the three gallery wings (keys I, II, III).
                 The architecture/lighting theme of each wing is fixed:
                   I  = Classical (burgundy walls, gilded frames, herringbone)
                   II = Modernist (olive-alabaster, wood & brass, track lights)
                   III= Nocturne  (charcoal-slate, dramatic spotlights)
   • exhibits  : 6–8 works. Each entry:
       id            unique string
       title, subtitle, year, category, tags[], description
       imagePath     relative path to the artwork (PNG/JPG). Leave "" to use
                     the procedural canvas painting only.
       wing          "I" | "II" | "III"  — works are auto-hung along that wing
       orientation   "landscape" | "portrait" (frame proportions)
       fallbackStyle procedural painting used instantly / if the file is
                     missing: courtyard | seascape | abstract | stilllife |
                     gallery | sculpture | geometric | nocturne
       links[]       { label, url } external buttons on the curator plaque
   ========================================================================== */
const EUNOIA_CONFIG = {
  site: {
    title: "EUNOIA",
    overline: "A Museum of Animation & Visual Art",
    tagline: "Selected Works of Mangilaya · Animation, 3D CGI & Visual Arts",
